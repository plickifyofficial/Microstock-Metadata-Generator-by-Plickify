# ──────────────────────────────────────────────────────────────
# Microstock Metadata Generator - Environment Variables
#
# Copy this file to .env.local for local development and set the
# same variables in Vercel → Project → Settings → Environment
# Variables for production.
# ──────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (Project Settings → API → service_role).
# NEVER expose this to the client or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: groq | openai | gemini | openrouter | mistral | custom
AI_PROVIDER=groq

# Secret API key for the chosen provider
AI_API_KEY=

# Optional overrides
# AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI_BASE_URL=https://your-openai-compatible-endpoint/v1

# Bootstrap admin email (optional convenience for the FIRST admin only).
# After your first login the authorization lives in the admin_users table.
ADMIN_EMAIL=

# Public URL of this deployment (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
